# MAX Bot token — get it from Master Bot in MAX after moderation is approved
MAX_BOT_TOKEN=

# Secret sent by MAX in X-Max-Bot-Api-Secret header on every webhook POST.
# Allowed characters: A-Z, a-z, 0-9, hyphen (-). Min 5, max 256 chars.
MAX_WEBHOOK_SECRET=

# Public HTTPS URL where MAX will deliver events (port 443, trusted TLS cert required).
# Example: https://yourdomain.com/webhook
MAX_WEBHOOK_URL=

# Absolute path to the existing Excel file on your machine
# Example: /Users/yourname/Documents/evacuations.xlsx
EXCEL_FILE_PATH=

# Absolute path to the payroll Excel file (Дата/VIN/Услуга + one column
# per employee). Leave empty to skip payroll writing entirely.
PAYROLL_FILE_PATH=

# Chat ID of the MAX group to import messages from (used by daily_import.py).
# Shows up in the JSON logs as "chat_id" (a negative number for groups).
MAX_CHAT_ID=

# When true, the bot POSTS reminder messages into the chat for job
# requests that are still open after at least one full check cycle.
# Test with MAX_CHAT_ID pointed at a test group before enabling in production.
ENABLE_JOB_REMINDERS=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
