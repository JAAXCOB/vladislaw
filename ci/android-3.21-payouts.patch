+ void showPayoutAccountDialog(){LinearLayout form=Ui.column(this);Spinner method=new Spinner(this);String[] methods={"СБП","Банковская карта","Расчётный счёт"};method.setAdapter(new ArrayAdapter<String>(this,android.R.layout.simple_spinner_dropdown_item,methods));EditText holder=Ui.input(this,"Получатель — ФИО"),primary=Ui.input(this,"Телефон СБП"),bik=Ui.input(this,"БИК — только для счёта"),bank=Ui.input(this,"Название банка");form.addView(method);form.addView(holder);form.addView(primary);form.addView(bik);form.addView(bank);method.setOnItemSelectedListener(new android.widget.AdapterView.OnItemSelectedListener(){public void onNothingSelected(android.widget.AdapterView<?> p){}public void onItemSelected(android.widget.AdapterView<?> p,View v,int x,long id){primary.setHint(x==0?"Телефон СБП":x==1?"Номер банковской карты":"Номер расчётного счёта (20 цифр)");bik.setVisibility(x==2?View.VISIBLE:View.GONE);}});JSONObject p=data.optJSONObject("profile"),old=data.optJSONObject("payout_account");holder.setText(old==null?(p==null?"":p.optString("name","")):old.optString("holder_name",p==null?"":p.optString("name","")));bank.setText(old==null?"":old.optString("bank_name",""));new AlertDialog.Builder(this).setTitle("Способ выплаты").setView(form).setNegativeButton("Отмена",null).setPositiveButton("Сохранить",(d,w)->savePayoutAccount(method.getSelectedItemPosition(),holder.getText().toString(),primary.getText().toString(),bik.getText().toString(),bank.getText().toString())).show();}
+ void savePayoutAccount(int selected,String holder,String value,String bik,String bank){String method=selected==0?"sbp":selected==1?"card":"bank_account";JSONObject body=new JSONObject();try{body.put("method",method).put("holder_name",holder).put("bank_name",bank);if("sbp".equals(method))body.put("phone",value);else if("card".equals(method))body.put("card_number",value);else body.put("bank_account",value).put("bik",bik);}catch(Exception ignored){}new Thread(()->{try{JSONObject r=ApiClient.post("/api/payout_account.php",body);runOnUiThread(()->{Toast.makeText(this,r.optBoolean("ok")?"Способ выплаты сохранён":r.optString("error","Не удалось сохранить"),Toast.LENGTH_LONG).show();if(r.optBoolean("ok"))load();});}catch(Exception e){runOnUiThread(()->Toast.makeText(this,"Нет связи с AV Rescue",Toast.LENGTH_LONG).show());}}).start();}
