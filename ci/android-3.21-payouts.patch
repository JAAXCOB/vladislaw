- void requestPayout(EditText amountField,EditText detailsField,Button button){double amount;try{amount=Double.parseDouble(amountField.getText().toString().trim().replace(',','.'));}catch(Exception e){Toast.makeText(this,"Укажите сумму выплаты",Toast.LENGTH_LONG).show();return;}String details=detailsField.getText().toString().trim();if(details.length()<4){Toast.makeText(this,"Укажите телефон СБП или реквизиты",Toast.LENGTH_LONG).show();return;}button.setEnabled(false);button.setText("Отправляем…");new Thread(()->{try{JSONObject r=ApiClient.post("/api/mobile_payout.php",new JSONObject().put("amount",amount).put("details",details));runOnUiThread(()->{if(r.optBoolean("ok")){Toast.makeText(this,"Заявка "+r.optString("payout_id")+" создана",Toast.LENGTH_LONG).show();refreshQuiet();}else{button.setEnabled(true);button.setText("Отправить заявку");Toast.makeText(this,r.optString("error","Заявка не создана"),Toast.LENGTH_LONG).show();}});}catch(Exception e){runOnUiThread(()->{button.setEnabled(true);button.setText("Отправить заявку");Toast.makeText(this,"Нет связи с AV Rescue",Toast.LENGTH_LONG).show();});}}).start();}
