diff --git a/scripts/diagnose_max.py b/scripts/diagnose_max.py
new file mode 100644
index 0000000..ff9a6a6
--- /dev/null
+++ b/scripts/diagnose_max.py
@@ -0,0 +1,143 @@
+"""Read-only MAX diagnostics. Never sends messages or changes subscriptions.
+
+Run: python -m scripts.diagnose_max --chat-id <B2B_CHAT_ID>
+Credentials come from the environment/.env, never command-line arguments.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from typing import Any
+
+import httpx
+from dotenv import load_dotenv
+
+MAX_API_BASE = "https://platform-api2.max.ru"
+
+
+def _get(client: httpx.Client, path: str) -> tuple[dict[str, Any], dict[str, Any] | None]:
+    try:
+        response = client.get(path)
+    except httpx.RequestError:
+        # Exception messages and response bodies can contain sensitive data.
+        return {"status": "network_or_tls_error"}, None
+    summary: dict[str, Any] = {"http_status": response.status_code}
+    if response.status_code != 200:
+        summary["status"] = {
+            401: "unauthorized", 403: "forbidden", 404: "not_found",
+            429: "rate_limited",
+        }.get(response.status_code, "http_error")
+        return summary, None
+    try:
+        payload = response.json()
+    except ValueError:
+        summary["status"] = "invalid_response"
+        return summary, None
+    if not isinstance(payload, dict):
+        summary["status"] = "invalid_response"
+        return summary, None
+    summary["status"] = "ok"
+    return summary, payload
+
+
+def diagnose(
+    client: httpx.Client,
+    chat_id: int,
+    *,
+    expected_bot_id: int | None = None,
+    expected_webhook_url: str | None = None,
+) -> dict[str, Any]:
+    """Return an allowlisted summary; no names, messages, URLs or secrets."""
+    report: dict[str, Any] = {"read_only": True, "message_delivery_tested": False}
+    report["bot"], bot = _get(client, "/me")
+    if bot is None:
+        return report
+    if bot.get("is_bot") is not True or not isinstance(bot.get("user_id"), int):
+        report["bot"]["status"] = "invalid_response"
+        return report
+    if expected_bot_id is not None:
+        report["bot"]["matches_expected"] = bot["user_id"] == expected_bot_id
+        if not report["bot"]["matches_expected"]:
+            report["bot"]["status"] = "wrong_bot"
+            return report
+
+    report["chat"], chat = _get(client, f"/chats/{chat_id}")
+    if chat is not None:
+        chat_status = chat.get("status")
+        chat_type = chat.get("type")
+        if chat.get("chat_id") != chat_id or chat_status not in {"active", "removed", "left", "closed"} or chat_type not in {"chat", "channel", "dialog"}:
+            report["chat"]["status"] = "invalid_response"
+        else:
+            report["chat"]["active"] = chat_status == "active"
+            report["chat"]["type"] = chat_type
+            if chat_status != "active":
+                report["chat"]["status"] = "inactive"
+
+    report["membership"], member = _get(client, f"/chats/{chat_id}/members/me")
+    if member is not None:
+        permissions = member.get("permissions")
+        if member.get("user_id") != bot["user_id"] or (permissions is not None and not isinstance(permissions, list)):
+            report["membership"]["status"] = "invalid_response"
+        else:
+            report["membership"]["is_admin"] = member.get("is_admin") is True
+            report["membership"]["permissions_reported"] = permissions is not None
+            report["membership"]["write_permission_reported"] = any(
+                p in (permissions or []) for p in ("write", "post_edit_delete_message")
+            )
+            # Ordinary chat members may have no permissions field and still send.
+            # A read-only check cannot prove a POST /messages would succeed.
+
+    report["subscriptions"], data = _get(client, "/subscriptions")
+    if data is not None:
+        subscriptions = data.get("subscriptions")
+        if not isinstance(subscriptions, list) or not all(isinstance(s, dict) for s in subscriptions):
+            report["subscriptions"]["status"] = "invalid_response"
+        else:
+            report["subscriptions"]["count"] = len(subscriptions)
+            if expected_webhook_url:
+                matches = [s for s in subscriptions if s.get("url") == expected_webhook_url]
+                report["subscriptions"]["expected_url_found"] = bool(matches)
+                for event in ("message_created", "message_edited", "message_removed", "message_callback"):
+                    report["subscriptions"][event] = any(
+                        s.get("update_types") is None
+                        or isinstance(s.get("update_types"), list) and event in s["update_types"]
+                        for s in matches
+                    )
+    return report
+
+
+def main() -> int:
+    load_dotenv()
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--chat-id", type=int)
+    parser.add_argument("--expected-bot-id", type=int)
+    args = parser.parse_args()
+    token = os.getenv("MAX_BOT_TOKEN", "")
+    raw_chat_id = os.getenv("MAX_B2B_CHAT_ID", "")
+    try:
+        chat_id = args.chat_id if args.chat_id is not None else int(raw_chat_id)
+    except ValueError:
+        print(json.dumps({"status": "missing_or_invalid_chat_id", "read_only": True}))
+        return 2
+    if not token.strip():
+        print(json.dumps({"status": "missing_bot_token", "read_only": True}))
+        return 2
+    # Fixed official host and no redirects: credentials cannot be redirected.
+    with httpx.Client(
+        base_url=MAX_API_BASE, headers={"Authorization": token},
+        timeout=15, follow_redirects=False,
+    ) as client:
+        report = diagnose(
+            client, chat_id, expected_bot_id=args.expected_bot_id,
+            expected_webhook_url=os.getenv("MAX_WEBHOOK_URL") or None,
+        )
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    return 1 if any(
+        isinstance(value, dict) and value.get("status") != "ok"
+        for value in report.values()
+    ) else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_max_acknowledgements.py b/tests/test_max_acknowledgements.py
new file mode 100644
index 0000000..d876cab
--- /dev/null
+++ b/tests/test_max_acknowledgements.py
@@ -0,0 +1,158 @@
+import os
+import threading
+from unittest.mock import MagicMock
+
+import httpx
+import pytest
+
+os.environ.setdefault("MAX_BOT_TOKEN", "test-token-placeholder")
+os.environ.setdefault("MAX_WEBHOOK_SECRET", "test-secret-ABC")
+os.environ.setdefault("MAX_CHAT_ID", "987654321")
+
+from webhook import av_rescue_client as integration
+from webhook.max_client import MaxAPIError
+
+
+@pytest.fixture
+def isolated_outbox(tmp_path, monkeypatch):
+    monkeypatch.setattr(integration.settings, "max_ack_queue_path", str(tmp_path / "ack.json"))
+    monkeypatch.setattr(integration.settings, "av_rescue_api_url", "https://example.com/sync")
+    monkeypatch.setattr(integration.settings, "av_rescue_api_key", "test-only-key")
+    monkeypatch.setattr(integration.settings, "max_chat_id", "987654321")
+    monkeypatch.setattr(integration.time, "time", lambda: 1000)
+    return tmp_path / "ack.json"
+
+
+def payload():
+    return {
+        "event": "upsert", "source_id": "max:987654321:mid.1",
+        "source_chat_id": "987654321", "source_message_id": "mid.1",
+    }
+
+
+def reply():
+    return {
+        "ok": True, "reply_required": True,
+        "reply_chat_id": "987654321", "reply_text": "Заявка принята системой",
+    }
+
+
+def test_site_retry_cannot_erase_failed_acknowledgement(isolated_outbox, monkeypatch):
+    client = MagicMock()
+    client.__enter__.return_value = client
+    client.post.side_effect = [
+        httpx.Response(200, json=reply()),
+        httpx.Response(200, json={"ok": True, "reply_required": False}),
+    ]
+    monkeypatch.setattr(integration.httpx, "Client", lambda **kwargs: client)
+    sender = MagicMock(side_effect=MaxAPIError(503))
+    monkeypatch.setattr(integration, "send_message", sender)
+
+    assert integration._post(payload()) is True
+    assert sender.call_count == 0  # saved before sending
+    assert integration.drain_order_acknowledgements() == 1
+    assert sender.call_count == 1  # no plain retry on a transient server error
+    assert integration.pending_ack_count() == 1
+    assert integration._post(payload()) is True
+    assert integration.pending_ack_count() == 1
+
+    sender.side_effect = None
+    monkeypatch.setattr(integration.time, "time", lambda: 1020)
+    assert integration.drain_order_acknowledgements() == 1
+    assert integration.pending_ack_count() == 0
+    assert sender.call_args.kwargs["reply_to_mid"] == "mid.1"
+    assert client.post.call_count == 2
+
+
+def test_duplicate_and_edit_do_not_resend_delivered_ack(isolated_outbox, monkeypatch):
+    sender = MagicMock()
+    monkeypatch.setattr(integration, "send_message", sender)
+    integration._enqueue_order_ack(reply(), payload())
+    integration._enqueue_order_ack(reply(), payload())
+    assert integration.pending_ack_count() == 1
+    assert integration.drain_order_acknowledgements() == 1
+    integration._enqueue_order_ack(reply(), {**payload(), "comment": "edited"})
+    assert integration.drain_order_acknowledgements() == 0
+    assert sender.call_count == 1
+    sent = integration._read_queue(isolated_outbox.with_name("ack.sent.json"))
+    assert "response_data" not in sent[0]
+
+
+def test_missing_reply_flag_does_not_invent_acceptance(isolated_outbox, monkeypatch, caplog):
+    sender = MagicMock()
+    monkeypatch.setattr(integration, "send_message", sender)
+    with caplog.at_level("INFO"):
+        integration._enqueue_order_ack({"ok": True}, payload())
+    assert integration.pending_ack_count() == 0
+    assert "flag_present=False" in caplog.text
+    sender.assert_not_called()
+
+
+@pytest.mark.parametrize("changes", [
+    {"reply_chat_id": "111"}, {"reply_text": ""},
+])
+def test_invalid_reply_is_quarantined_not_silently_lost(isolated_outbox, monkeypatch, changes):
+    sender = MagicMock()
+    monkeypatch.setattr(integration, "send_message", sender)
+    monkeypatch.setattr(integration, "MAX_DELIVERY_ATTEMPTS", 1)
+    integration._enqueue_order_ack({**reply(), **changes}, payload())
+    integration.drain_order_acknowledgements()
+    sender.assert_not_called()
+    assert integration.pending_ack_count() == 0
+    dead = integration._read_queue(isolated_outbox.with_name("ack.dead.json"))
+    assert dead[0]["response_data"]["reply_required"] is True
+
+
+def test_invalid_reply_link_falls_back_to_plain_message(isolated_outbox, monkeypatch):
+    sender = MagicMock(side_effect=[MaxAPIError(404), None])
+    monkeypatch.setattr(integration, "send_message", sender)
+    integration._enqueue_order_ack(reply(), payload())
+    integration.drain_order_acknowledgements()
+    assert sender.call_count == 2
+    assert sender.call_args_list[0].kwargs == {"reply_to_mid": "mid.1"}
+    assert sender.call_args_list[1].kwargs == {}
+    assert integration.pending_ack_count() == 0
+
+
+def test_network_timeout_retains_ack_for_a_later_worker_cycle(isolated_outbox, monkeypatch):
+    sender = MagicMock(side_effect=httpx.ReadTimeout("synthetic timeout"))
+    monkeypatch.setattr(integration, "send_message", sender)
+    integration._enqueue_order_ack(reply(), payload())
+    integration.drain_order_acknowledgements()
+    assert sender.call_count == 1
+    row = integration._read_queue(isolated_outbox)[0]
+    assert row["response_data"]["reply_text"] == reply()["reply_text"]
+    assert row["attempts"] == 1
+    assert row["next_attempt_at"] > 1000
+
+
+def test_destination_title_is_separate_from_address():
