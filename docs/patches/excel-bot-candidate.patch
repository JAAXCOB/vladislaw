+    assert integration._split_destination_field(text, text) == (
+        "CIDR | FIT ЮНЫХ ЛЕНИНЦЕВ", "ПОДОЛЬСК, ЮНЫХ ЛЕНИНЦЕВ ПР-КТ, 11",
+    )
+
+
+def test_unstructured_destination_keeps_existing_fallback():
