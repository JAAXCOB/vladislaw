+        None, "Существующий адрес",
+    )
+
+
+def test_inbox_worker_retries_ack_when_no_new_messages(monkeypatch):
+    from webhook import event_inbox
+    stopped = threading.Event()
+    ran = threading.Event()
+    monkeypatch.setattr(event_inbox, "_stop_event", stopped)
+    monkeypatch.setattr(event_inbox, "_worker", None)
+    monkeypatch.setattr(event_inbox, "drain", lambda processor: 0)
+
+    def maintenance():
+        ran.set()
+        stopped.set()
+
+    event_inbox.start_worker(lambda payload: None, maintenance=maintenance)
+    try:
+        assert ran.wait(2)
+    finally:
+        event_inbox.stop_worker()
