+def _ack_queue_path() -> Path:
+    path = Path(settings.max_ack_queue_path)
+    return path if path.is_absolute() else Path(__file__).resolve().parent.parent / path
+
+
+def pending_ack_count() -> int:
+    path = _ack_queue_path()
+    with file_lock(path):
+        try:
+            return len(_read_queue(path))
+        except Exception:
+            return -1
+
+
+def _enqueue_order_ack(response_data: dict[str, Any], payload: dict[str, Any]) -> None:
+    if response_data.get("reply_required") is not True:
+        log.info(
+            "AV Rescue acknowledgement not requested | flag_present=%s",
+            "reply_required" in response_data,
+        )
+        return
+    if not payload.get("source_id"):
+        raise ValueError("An acknowledgement requires a stable source_id")
+    path = _ack_queue_path()
+    sent_path = path.with_name(path.stem + ".sent" + path.suffix)
+    with file_lock(path):
+        pending = _read_queue(path)
+        sent = _read_queue(sent_path)
+        key = _payload_key(payload)
+        if any(_payload_key(item.get("payload", {})) == key for item in pending + sent):
+            return
+        pending.append({
+            "payload": {
+                "source_id": payload["source_id"], "event": "upsert",
+                "source_chat_id": payload.get("source_chat_id"),
+                "source_message_id": payload.get("source_message_id"),
+            },
+            "response_data": {
+                "reply_required": True,
+                "reply_chat_id": response_data.get("reply_chat_id"),
+                "reply_text": response_data.get("reply_text"),
+            },
+            "attempts": 0, "next_attempt_at": 0,
+        })
+        _write_queue(pending, path)
+
+
+def drain_order_acknowledgements(max_items: int = 2) -> int:
+    """Retry saved MAX replies without resubmitting already-saved site orders.
+
+    Delivery is at least once: a crash after MAX accepts a message but before
+    the local sent marker is saved can cause a duplicate. No send is initiated
+    merely because a site response says ok without reply_required=true.
+    """
+    path = _ack_queue_path()
+    sent_path = path.with_name(path.stem + ".sent" + path.suffix)
+    dead_path = path.with_name(path.stem + ".dead" + path.suffix)
+    processed = 0
+    with file_lock(path):
+        pending = _read_queue(path)
+        sent = _read_queue(sent_path)
+        remaining = []
+        for item in pending:
+            payload = item.get("payload", {})
+            if any(_payload_key(row.get("payload", {})) == _payload_key(payload) for row in sent):
+                continue
+            if processed >= max_items or int(item.get("next_attempt_at", 0)) > time.time():
+                remaining.append(item)
+                continue
+            processed += 1
+            try:
+                _send_order_ack(item.get("response_data", {}), payload)
+            except Exception as exc:
+                failed = {**item, **_failure_record(payload, item)}
+                log.warning(
+                    "MAX acknowledgement delivery failed | attempt=%d | error=%s",
+                    failed["attempts"], type(exc).__name__,
+                )
+                if failed["attempts"] >= MAX_DELIVERY_ATTEMPTS:
+                    dead = _read_queue(dead_path)
+                    dead.append(failed)
+                    _write_queue(dead, dead_path)
+                else:
+                    remaining.append(failed)
+            else:
+                sent.append({
+                    "payload": {"source_id": payload.get("source_id"), "event": "upsert"},
+                    "sent_at": int(time.time()),
+                })
+                _write_queue(sent, sent_path)
+        _write_queue(remaining, path)
+    return processed
+
+
