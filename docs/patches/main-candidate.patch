+import os
+
+import pytest
+from pydantic import ValidationError
+
+os.environ.setdefault("MAX_BOT_TOKEN", "test-token-placeholder")
+os.environ.setdefault("MAX_WEBHOOK_SECRET", "test-secret-ABC")
+
+from webhook.config import Settings
+
+
+@pytest.mark.parametrize("secret", ["", "abcd", "has space", "has_underscore", "я" * 10, "a" * 257])
+def test_invalid_webhook_secret_prevents_startup(secret):
+    with pytest.raises(ValidationError):
+        Settings(_env_file=None, max_bot_token="test-token", max_webhook_secret=secret)
+
+
+@pytest.mark.parametrize("token", ["", "   "])
+def test_blank_bot_token_prevents_startup(token):
+    with pytest.raises(ValidationError):
+        Settings(_env_file=None, max_bot_token=token, max_webhook_secret="test-secret")
+
+
+def test_config_validation_does_not_print_secret_input():
+    invalid = "PRIVATE_secret_material"
+    with pytest.raises(ValidationError) as error:
+        Settings(_env_file=None, max_bot_token="test-token", max_webhook_secret=invalid)
+    assert invalid not in str(error.value)
+
+
+def test_credentials_are_not_in_config_repr():
+    config = Settings(_env_file=None, max_bot_token="private-token", max_webhook_secret="private-secret")
+    assert "private-token" not in repr(config)
+    assert "private-secret" not in repr(config)
