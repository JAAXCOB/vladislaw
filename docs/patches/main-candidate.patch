new file mode 100644
index 0000000..71c75a0
--- /dev/null
+++ b/deployment/schema/transactional_storage_pilot.sql
@@ -0,0 +1,44 @@
+-- Isolated SQLite pilot only; NOT an automatic production migration.
+PRAGMA foreign_keys = ON;
+CREATE TABLE workers (id TEXT PRIMARY KEY, status TEXT NOT NULL);
+CREATE TABLE orders (
+ id TEXT PRIMARY KEY, status TEXT NOT NULL, source TEXT NOT NULL,
+ worker_id TEXT REFERENCES workers(id), version INTEGER NOT NULL DEFAULT 0 CHECK(version >= 0),
+ amount_minor INTEGER NOT NULL CHECK(amount_minor > 0), currency TEXT NOT NULL CHECK(currency = '643')
+);
+CREATE UNIQUE INDEX one_active_order_per_worker ON orders(worker_id)
+ WHERE worker_id IS NOT NULL AND status IN ('assigned','enroute','arrived','in_transit');
+CREATE TABLE payment_verifications (
+ id TEXT PRIMARY KEY, order_id TEXT NOT NULL REFERENCES orders(id),
+ provider TEXT NOT NULL, provider_payment_id TEXT NOT NULL,
+ amount_minor INTEGER NOT NULL CHECK(amount_minor > 0), currency TEXT NOT NULL CHECK(currency = '643'),
+ status TEXT NOT NULL CHECK(status IN ('captured','refunded','reversed')),
+ verified_at TEXT NOT NULL, UNIQUE(provider,provider_payment_id)
+);
+CREATE TABLE ledger (
+ id TEXT PRIMARY KEY, order_id TEXT NOT NULL REFERENCES orders(id), worker_id TEXT NOT NULL REFERENCES workers(id),
+ type TEXT NOT NULL CHECK(type IN ('commission_debit','driver_credit','reversal')),
+ amount_minor INTEGER NOT NULL CHECK(amount_minor != 0),
+ payment_verification_id TEXT REFERENCES payment_verifications(id),
+ idempotency_key TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL,
+ UNIQUE(order_id,worker_id,type)
+);
+CREATE TRIGGER validate_driver_credit BEFORE INSERT ON ledger WHEN NEW.type='driver_credit'
+BEGIN
+ SELECT CASE WHEN NOT EXISTS (
+  SELECT 1 FROM payment_verifications p JOIN orders o ON o.id=p.order_id
+  WHERE p.id=NEW.payment_verification_id AND p.order_id=NEW.order_id
+   AND p.status='captured' AND p.amount_minor=o.amount_minor AND p.currency=o.currency
+   AND o.status IN ('done','completed') AND o.source!='max_partner'
+   AND o.worker_id=NEW.worker_id AND NEW.amount_minor>0 AND NEW.amount_minor<=p.amount_minor
+ ) THEN RAISE(ABORT,'Unverified or mismatched payment') END;
+END;
+CREATE TABLE outbox (
+ id TEXT PRIMARY KEY, event_key TEXT NOT NULL UNIQUE, order_id TEXT NOT NULL REFERENCES orders(id),
+ event_type TEXT NOT NULL, payload_json TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending',
+ attempts INTEGER NOT NULL DEFAULT 0, next_attempt_at TEXT, created_at TEXT NOT NULL
+);
+CREATE TABLE audit_events (
+ id TEXT PRIMARY KEY, actor_id TEXT NOT NULL, action TEXT NOT NULL,
+ entity_id TEXT NOT NULL, correlation_id TEXT NOT NULL, created_at TEXT NOT NULL
+);
