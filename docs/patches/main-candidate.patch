+"""Schema invariants on isolated SQLite files, not production adapter tests."""
+import sqlite3
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pytest
+
+SCHEMA = Path(__file__).resolve().parents[1] / 'deployment/schema/transactional_storage_pilot.sql'
+
+
+def db(path):
+    conn = sqlite3.connect(path, timeout=5)
+    conn.execute('PRAGMA foreign_keys=ON')
+    return conn
+
+
+@pytest.fixture
+def pilot(tmp_path):
+    path = tmp_path / 'pilot.sqlite'
+    with db(path) as conn:
+        conn.executescript(SCHEMA.read_text())
+        conn.execute("INSERT INTO workers VALUES ('w1','online'),('w2','online')")
+        conn.execute("INSERT INTO orders VALUES ('o','new','avr',NULL,0,100000,'643')")
+    return path
+
+
+def test_two_claims_have_one_winner(pilot):
+    def claim(worker):
+        with db(pilot) as conn:
+            conn.execute('BEGIN IMMEDIATE')
+            changed = conn.execute("UPDATE orders SET worker_id=?,status='assigned',version=version+1 WHERE id='o' AND version=0 AND status='new'", (worker,)).rowcount
+            return changed
+    with ThreadPoolExecutor(2) as pool:
+        assert sorted(pool.map(claim, ['w1', 'w2'])) == [0, 1]
+    with db(pilot) as conn:
+        assert conn.execute("SELECT version FROM orders WHERE id='o'").fetchone() == (1,)
+
+
+def prepare(conn, payment_amount=100000, payment_status='captured'):
+    conn.execute("UPDATE orders SET status='done',worker_id='w1' WHERE id='o'")
+    conn.execute("INSERT INTO payment_verifications VALUES ('p','o','fixture','bank-id',?,'643',?,'fixture-time')", (payment_amount, payment_status))
+
+
+def credit(conn):
+    conn.execute("INSERT INTO ledger VALUES ('l','o','w1','driver_credit',65000,'p','credit-o','fixture-time')")
+
+
+@pytest.mark.parametrize('amount,status', [(99999, 'captured'), (100000, 'refunded'), (100000, 'reversed')])
+def test_unconfirmed_credit_rejected(pilot, amount, status):
+    with db(pilot) as conn:
+        prepare(conn, amount, status)
+        with pytest.raises(sqlite3.IntegrityError):
+            credit(conn)
+        assert conn.execute('SELECT COUNT(*) FROM ledger').fetchone() == (0,)
+
+
+def test_duplicate_credit_rejected(pilot):
+    with db(pilot) as conn:
+        prepare(conn)
+        credit(conn)
+        with pytest.raises(sqlite3.IntegrityError):
+            credit(conn)
+        assert conn.execute('SELECT COUNT(*) FROM ledger').fetchone() == (1,)
+
+
+def test_outbox_failure_rolls_back_entire_transaction(pilot):
+    with db(pilot) as conn:
+        prepare(conn)
+        conn.execute("INSERT INTO outbox VALUES ('e','event-o','o','ack','{}','pending',0,NULL,'fixture-time')")
+    with pytest.raises(sqlite3.IntegrityError), db(pilot) as conn:
+        conn.execute('BEGIN IMMEDIATE')
+        credit(conn)
+        conn.execute("INSERT INTO outbox VALUES ('e2','event-o','o','ack','{}','pending',0,NULL,'fixture-time')")
+    with db(pilot) as conn:
+        assert conn.execute('SELECT COUNT(*) FROM ledger').fetchone() == (0,)
