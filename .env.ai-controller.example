# Required read-only monitoring targets.
AVR_AI_SITE_HEALTH_URL=https://av-rescue.ru/health
AVR_AI_MAX_HEALTH_URL=http://127.0.0.1:8000/health
AVR_AI_OSRM_BASE_URL=https://router.example.invalid
AVR_AI_OSRM_PROBE_LON=37.6176
AVR_AI_OSRM_PROBE_LAT=55.7558

# Separate state; do not point this at data/excel or payroll files.
AVR_AI_DATA_DIR=/opt/vladislaw/data/ai-controller
AVR_AI_POLL_INTERVAL_SECONDS=60
AVR_AI_REQUEST_TIMEOUT_SECONDS=8
AVR_AI_LOG_LEVEL=INFO
# The example value is rejected at startup. Generate a dedicated value for this service.
AVR_AI_AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters

# Fail-closed cost controls. Keep these values for the observation pilot.
AVR_AI_PAID_API_ENABLED=false
AVR_AI_DAILY_BUDGET_MINOR=0
AVR_AI_MONTHLY_BUDGET_MINOR=0
AVR_AI_PER_REQUEST_BUDGET_MINOR=0

# A separate controller bot and a closed control chat. Never reuse MAX_BOT_TOKEN.
AVR_AI_MAX_CONTROL_ENABLED=false
AVR_AI_MAX_CONTROL_TOKEN=
AVR_AI_MAX_CONTROL_CHAT_ID=
AVR_AI_MAX_CONTROL_USER_IDS=
AVR_AI_MAX_CONTROL_API_BASE=https://platform-api2.max.ru
AVR_AI_MAX_CONTROL_POLL_TIMEOUT_SECONDS=20
AVR_AI_MAX_CONTROL_COMMAND_TTL_SECONDS=180

# Yandex IMAP is read-only: SELECT readonly + BODY.PEEK headers only.
AVR_AI_YANDEX_MAIL_ENABLED=false
AVR_AI_YANDEX_IMAP_HOST=imap.yandex.ru
AVR_AI_YANDEX_IMAP_PORT=993
AVR_AI_YANDEX_MAILBOX=
AVR_AI_YANDEX_APP_PASSWORD=

# OAuth token must be authorized only for gmail.readonly.
AVR_AI_GMAIL_ENABLED=false
AVR_AI_GMAIL_CLIENT_ID=
AVR_AI_GMAIL_CLIENT_SECRET=
AVR_AI_GMAIL_REFRESH_TOKEN=
AVR_AI_GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token
AVR_AI_GMAIL_API_BASE=https://gmail.googleapis.com/gmail/v1
AVR_AI_MAIL_SAMPLE_LIMIT=10
